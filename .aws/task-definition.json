{
  "family": "coachify-account-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::659544100085:role/AmazonECSTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::659544100085:role/ecsInstanceRole1",
  "containerDefinitions": [
    {
      "name": "account-api",
      "image": "659544100085.dkr.ecr.us-east-1.amazonaws.com/coachify/account-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8086,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "PORT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:PORT::"
        },
        {
          "name": "ENVIRONMENT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:ENVIRONMENT::"
        },
        {
          "name": "BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:BASE_URL::"
        },
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:MONGODB_URI::"
        },
        {
          "name": "MAILGUN_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:MAILGUN_API_KEY::"
        },
        {
          "name": "MAILGUN_DOMAIN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:MAILGUN_DOMAIN::"
        },
        {
          "name": "IDENTIFIER_API_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:IDENTIFIER_API_URL::"
        },
        {
          "name": "INVITATION_API_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:INVITATION_API_URL::"
        },
        {
          "name": "NOTIFICATION_API_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:NOTIFICATION_API_URL::"
        },
        {
          "name": "CHAT_API_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:CHAT_API_URL::"
        },
        {
          "name": "PAYMENT_API_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:PAYMENT_API_URL::"
        },
        {
          "name": "PLAN_HEX_COACH",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:PLAN_HEX_COACH::"
        },
        {
          "name": "PLAN_HEX_CLIENT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:PLAN_HEX_CLIENT::"
        },
        {
          "name": "CONFIRMATION_CODE_TEMPLATE_PENDING",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:CONFIRMATION_CODE_TEMPLATE_PENDING::"
        },
        {
          "name": "RESEND_CONFIRMATION_TEMPLATE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:RESEND_CONFIRMATION_TEMPLATE::"
        },
        {
          "name": "RESET_PASSWORD_TEMPLATE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:RESET_PASSWORD_TEMPLATE::"
        },
        {
          "name": "CONFIRM_RESET_PASSWORD_TEMPLATE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:CONFIRM_RESET_PASSWORD_TEMPLATE::"
        },
        {
          "name": "WELCOME_TEMPLATE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:WELCOME_TEMPLATE::"
        },
        {
          "name": "FACEBOOK_APP_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:FACEBOOK_APP_ID::"
        },
        {
          "name": "FACEBOOK_APP_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:FACEBOOK_APP_SECRET::"
        },
        {
          "name": "FACEBOOK_REDIRECT_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:FACEBOOK_REDIRECT_URL::"
        },
        {
          "name": "FACEBOOK_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:FACEBOOK_ENCRYPTION_KEY::"
        },
        {
          "name": "GOOGLE_APP_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:GOOGLE_APP_ID::"
        },
        {
          "name": "GOOGLE_APP_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:GOOGLE_APP_SECRET::"
        },
        {
          "name": "GOOGLE_REDIRECT_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:GOOGLE_REDIRECT_URL::"
        },
        {
          "name": "GOOGLE_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:GOOGLE_ENCRYPTION_KEY::"
        },
        {
          "name": "COACHIFY_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:COACHIFY_ENCRYPTION_KEY::"
        },
        {
          "name": "COACHIFY_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:659544100085:secret:prod/coachify:COACHIFY_SECRET_KEY::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/coachify/account-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:8086/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 40
      }
    }
  ]
}